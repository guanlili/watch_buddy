# TokenDance 大模型网关（OpenAI 兼容）
# 控制台：https://tokendance.space/keys
TOKENDANCE_API_KEY=sk-your-key-here

# 可选：默认模型 ID（缺省为 deepseek-v3.2）
# 其他可选：minimax-m2.5、claude-sonnet-4-5、gemini-2.5-pro 等
# 完整列表见 https://tokendance.space/models
# TOKENDANCE_MODEL=deepseek-v3.2

# 可选：自定义网关地址（缺省为官方）
# TOKENDANCE_BASE_URL=https://tokendance.space/gateway

# StepFun 语音识别（stepaudio-2.5-asr）
# 控制台：https://platform.stepfun.com/interface-key
STEP_API_KEY=your-step-api-key

# 可选：自定义 StepFun API 地址
# STEP_BASE_URL=https://api.stepfun.com
